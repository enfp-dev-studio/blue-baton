{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The settings window and the menu bar panel: events, notifications, panel sizing",
  "windows": [
    "main",
    "panel"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-hide",
    "core:window:allow-set-theme",
    "notification:default"
  ]
}
