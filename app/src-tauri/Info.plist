<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the app bundle's Info.plist by Tauri. LSUIElement: a menu bar app, never in the Dock or the app switcher.
  CFBundleLocalizations: the languages the UI has (ui/src/locales; the app localizes itself), so macOS offers them
  for this app in System Settings → General → Language & Region and tells the window which one to use.
-->
<plist version="1.0">
<dict>
  <key>LSUIElement</key>
  <true/>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>ko</string>
    <string>ja</string>
    <string>zh-Hans</string>
    <string>zh-Hant</string>
    <string>es</string>
    <string>de</string>
    <string>fr</string>
  </array>
</dict>
</plist>
