{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blue Baton",
  "version": "0.7.1",
  "identifier": "com.enfpdev.bluebaton",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "beforeBuildCommand": "pnpm --dir ../ui build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Blue Baton",
        "url": "index.html",
        "width": 960,
        "height": 800,
        "minWidth": 380,
        "minHeight": 520,
        "visible": false
      },
      {
        "label": "panel",
        "title": "Blue Baton",
        "url": "index.html?view=panel",
        "width": 340,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "One Bluetooth keyboard and mouse for three computers",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "copyright": "Copyright (C) 2026 enfpdev. GPL-3.0-only",
    "license": "GPL-3.0-only"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1NjZFMzUwMzQ3RkIzREUKUldUZXMzODBVT05tVlNFUVlMYm16d1VRS3FTMFV5aDJLTzcyUisySnJrT2cvQkhPZ3EwSnlQME4K",
      "endpoints": [
        "https://github.com/enfp-dev-studio/blue-baton/releases/latest/download/latest.json"
      ]
    }
  }
}
