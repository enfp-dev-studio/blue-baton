# ESP-IDF build output. sdkconfig is regenerated identically from sdkconfig.defaults (checked 2026-10-09)
firmware/build/
firmware/build-dev/
node_modules/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/managed_components/
firmware/dependencies.lock

# Tool settings used only on this machine (ESP-IDF Python path, temporary log path)
.claude/

# Bridge logs carry keystrokes (including passkeys), so they stay out of the repository
*.bridge.log
bridge.log

.DS_Store
__pycache__/
*.pyc

# Local only: originals before redaction, real address mapping (never pushed to the public repository)
private/

# Local secrets files (release secrets go to GitHub, never into the repository)
.env
*.env
.env.*
