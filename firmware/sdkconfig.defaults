# Use NimBLE (Bluedroid off)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y

# Input device scan/connect (Central) and host connections (Peripheral) are used together
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y

# Log output goes to the board's USB port (instead of the default UART0)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 2 input + 3 host = 5, plus 1 incoming connection via advertising (when an unknown device briefly takes it), plus 1 input connection attempt
# (advertising and connection attempts need a free slot when they start, NimBLE ble_gap.c)
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=7
# Controller activities: 7 connections + 1 advertising + 1 scan or connection attempt
CONFIG_BT_CTRL_BLE_MAX_ACT=9
# Subscription storage: 7 CCCDs per host x 3 + one host being re-paired + headroom
CONFIG_BT_NIMBLE_MAX_CCCDS=32
# GATT procedure pool: at least the number of connections
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=8
# The host task also handles GATT server responses and report generation
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
# Persist bond keys in NVS (the default is RAM, which is lost on reboot)
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# Bond count: 4 input + 3 host + 1 in progress.
# NimBLE accepts a new pairing only when "stored count + in-progress security procedures < MAX_BONDS" (host/src/ble_sm.c)
CONFIG_BT_NIMBLE_MAX_BONDS=8
# No silent re-attempts inside the stack: a Peripheral link that fails before CONNECT then reaches the app as a
# failed CONNECT (host.c frees its state); the input side has its own reconnect (ble_pair.c)
# CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT is not set

# 4MB flash (confirmed with esptool flash-id)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Partition table: NVS 64KB, app 3MB (holds Wi-Fi and the settings UI)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Wi-Fi setup is off by default (USB comes first for now; turn it on when switching to the server mode)
CONFIG_KM_WIFI_ENABLE=n

# NimBLE logs every notification at INFO (two console lines in the host task, ~1 ms per report)
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# Speed of the BLE path (measured: each NimBLE layer took ~100 us for a mouse report at -Og/160 MHz/16 KB I-cache)
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
